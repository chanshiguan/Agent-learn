              "sources": [
                {
                  "id": "cba157b9d16b4ae3098c2268",
                  "doc_id": "036d118829961e4d",
                  "version": "a52a49dbc03594257c43ab3156f5de99db76ec2a54e18d58eaed04192f0dadb5",
                  "tenant": "demo",
